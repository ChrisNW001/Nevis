# Nevis Configuration

# API Keys (add your own)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Notion Integration
# Get your token at: https://www.notion.so/my-integrations
NOTION_TOKEN=
# Optional: Default database ID for queries
# NOTION_DEFAULT_DATABASE_ID=

# Fireflies.ai Integration
# Get your API key at: https://app.fireflies.ai/integrations/custom/fireflies
FIREFLIES_API_KEY=
# Optional: Default limit for transcript queries (default: 50)
# FIREFLIES_DEFAULT_LIMIT=50

# Slack Integration
# Create a Slack App at: https://api.slack.com/apps
# Enable Socket Mode and get tokens:
# 1. Bot Token (starts with xoxb-): OAuth & Permissions > Bot User OAuth Token
# 2. App Token (starts with xapp-): Basic Information > App-Level Tokens (needs connections:write scope)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Optional: Signing Secret from Basic Information page
# SLACK_SIGNING_SECRET=

# Service URLs
# NWSLIDE_AI_URL=http://localhost:3000

# Logging
LOG_LEVEL=INFO
