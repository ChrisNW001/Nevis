# Nevis Configuration

# API Keys (add your own)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Notion Integration
# Get your token at: https://www.notion.so/my-integrations
NOTION_TOKEN=
# Optional: Default database ID for queries
# NOTION_DEFAULT_DATABASE_ID=

# Slack Integration
# Create a Slack app at: https://api.slack.com/apps
SLACK_BOT_TOKEN=
# Optional: Default channel ID for messages
# SLACK_DEFAULT_CHANNEL=

# Service URLs
# NWSLIDE_AI_URL=http://localhost:3000

# Logging
LOG_LEVEL=INFO
